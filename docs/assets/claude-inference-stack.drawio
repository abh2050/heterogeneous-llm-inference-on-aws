<mxfile host="app.diagrams.net">
  <diagram id="stack" name="Claude Inference Full Stack">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Claude Inference Hosting, West Coast: Full Stack Map&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The request travels down the stack and tokens stream back up. Blue cells show the open, hardware neutral path (llm-d plus vLLM). Green cells show the NVIDIA path (Dynamo plus TensorRT-LLM)." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="52" width="1500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="h1" value="Tier" style="rounded=0;html=1;fillColor=#263238;fontColor=#FFFFFF;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="100" height="35" as="geometry"/></mxCell>
        <mxCell id="h2" value="Layer" style="rounded=0;html=1;fillColor=#263238;fontColor=#FFFFFF;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="180" y="95" width="200" height="35" as="geometry"/></mxCell>
        <mxCell id="h3" value="What the layer does" style="rounded=0;html=1;fillColor=#263238;fontColor=#FFFFFF;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="390" y="95" width="360" height="35" as="geometry"/></mxCell>
        <mxCell id="h4" value="Open, hardware neutral tools" style="rounded=0;html=1;fillColor=#6C8EBF;fontColor=#FFFFFF;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="760" y="95" width="330" height="35" as="geometry"/></mxCell>
        <mxCell id="h5" value="NVIDIA stack tools" style="rounded=0;html=1;fillColor=#82B366;fontColor=#FFFFFF;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1100" y="95" width="330" height="35" as="geometry"/></mxCell>
        <mxCell id="h6" value="Cross cutting systems" style="rounded=0;html=1;fillColor=#263238;fontColor=#FFFFFF;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1450" y="95" width="280" height="35" as="geometry"/></mxCell>

        <mxCell id="arrDown" value="Request" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#C62828;fontColor=#C62828;fontStyle=1;labelBackgroundColor=#FFFFFF;horizontal=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="32" y="140" as="sourcePoint"/><mxPoint x="32" y="1040" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="arrUp" value="Tokens" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#2E7D32;fontColor=#2E7D32;fontStyle=1;labelBackgroundColor=#FFFFFF;horizontal=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="55" y="1040" as="sourcePoint"/><mxPoint x="55" y="140" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="t1" value="ACCESS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="100" height="270" as="geometry"/></mxCell>
        <mxCell id="t2" value="CONTROL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="100" height="340" as="geometry"/></mxCell>
        <mxCell id="t3" value="COMPUTE SOFTWARE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B8860B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="70" y="770" width="100" height="200" as="geometry"/></mxCell>
        <mxCell id="t4" value="HARDWARE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="70" y="980" width="100" height="200" as="geometry"/></mxCell>
        <mxCell id="t5" value="INFRASTRUCTURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="70" y="1190" width="100" height="270" as="geometry"/></mxCell>

        <!-- Row 1 -->
        <mxCell id="l1" value="1. Client Apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="140" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="Claude apps, Claude Code, API SDKs, Bedrock, Vertex AI. Tokens return as SSE streams." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="140" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o1" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n1" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 2 -->
        <mxCell id="l2" value="2. Edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="210" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d2" value="GeoDNS or anycast, TLS termination, DDoS absorption. PoPs sit in LA, the Bay Area, and Seattle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="210" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o2" value="&lt;b&gt;Envoy&lt;/b&gt; proxies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="210" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n2" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="210" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 3 -->
        <mxCell id="l3" value="3. API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="280" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d3" value="Checks auth, applies rate limits by tier, validates schema, counts tokens, meters billing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="280" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o3" value="&lt;b&gt;Envoy AI Gateway&lt;/b&gt;, &lt;b&gt;Kong&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="280" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n3" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="280" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 4 -->
        <mxCell id="l4" value="4. Safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="350" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d4" value="Input and output classifiers run on a small, cheap accelerator pool and can halt a stream." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="350" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o4" value="&lt;b&gt;Llama Guard&lt;/b&gt; style classifiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;NeMo Guardrails&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="350" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 5 -->
        <mxCell id="l5" value="5. Router and Scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="420" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d5" value="Routes by prefix cache affinity, queue depth, KV memory, and priority class. Batch API work gets preempted first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="420" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o5" value="&lt;b&gt;llm-d&lt;/b&gt; Inference Scheduler (Gateway API Inference Extension)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="420" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Dynamo&lt;/b&gt; Smart Router (KV aware)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="420" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 6 -->
        <mxCell id="l6" value="6. Packaging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="490" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d6" value="Ships the model, the engine, and the API server together as one container." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="490" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o6" value="&lt;b&gt;vLLM&lt;/b&gt; container image on &lt;b&gt;KServe&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="490" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;NIM&lt;/b&gt; (NVIDIA Inference Microservices)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="490" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 7 -->
        <mxCell id="l7" value="7. Disaggregated Serving" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="560" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d7" value="Splits prefill (compute bound) and decode (memory bandwidth bound) into separate pools." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="560" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o7" value="&lt;b&gt;llm-d&lt;/b&gt; prefill and decode split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Dynamo&lt;/b&gt; orchestrates engines across nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="560" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 8 -->
        <mxCell id="l8" value="8. Inference Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="630" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d8" value="Runs continuous batching, PagedAttention, speculative decoding, and FP8 weights." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="630" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o8" value="&lt;b&gt;vLLM&lt;/b&gt;, &lt;b&gt;SGLang&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="630" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;TensorRT-LLM&lt;/b&gt;&lt;br&gt;&lt;b&gt;Triton Inference Server&lt;/b&gt; (legacy, now inside Dynamo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="630" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 9 -->
        <mxCell id="l9" value="9. KV Cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="700" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d9" value="Tiers cache from HBM to host DRAM to NVMe. RDMA moves cache from prefill nodes to decode nodes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="700" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o9" value="&lt;b&gt;LMCache&lt;/b&gt;, &lt;b&gt;NIXL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="700" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;Dynamo KV Block Manager&lt;/b&gt;, &lt;b&gt;NIXL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 10 -->
        <mxCell id="l10" value="10. Model Execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B8860B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="770" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d10" value="Splits the model with tensor, pipeline, and expert parallelism. Each platform passes a parity check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="770" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o10" value="&lt;b&gt;PyTorch&lt;/b&gt;, &lt;b&gt;JAX&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="770" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;NeMo&lt;/b&gt; (train, fine tune, evaluate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="770" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 11 -->
        <mxCell id="l11" value="11. Compiler and Kernels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B8860B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="840" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d11" value="Lowers the model graph to chip code. Fused attention and matmul kernels keep data on chip." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="840" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o11" value="&lt;b&gt;XLA&lt;/b&gt; (TPU), &lt;b&gt;Neuron&lt;/b&gt; (Trainium), &lt;b&gt;OpenAI Triton&lt;/b&gt; kernels, Intel &lt;b&gt;oneAPI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="840" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;CUDA&lt;/b&gt;, &lt;b&gt;cuDNN&lt;/b&gt;, &lt;b&gt;CUTLASS&lt;/b&gt;, &lt;b&gt;TensorRT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="840" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 12 -->
        <mxCell id="l12" value="12. Runtime and Drivers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B8860B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="910" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d12" value="Manages device memory, launches kernels, runs collectives such as all reduce. Versions stay pinned per pool." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="910" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o12" value="&lt;b&gt;libtpu&lt;/b&gt;, &lt;b&gt;Neuron runtime&lt;/b&gt;, &lt;b&gt;oneCCL&lt;/b&gt;, &lt;b&gt;RCCL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="910" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;CUDA runtime&lt;/b&gt;, &lt;b&gt;NCCL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="910" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 13 -->
        <mxCell id="l13" value="13. Accelerators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="980" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d13" value="Matrix units plus HBM. HBM size caps batch size. HBM bandwidth caps decode speed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="980" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o13" value="&lt;b&gt;Google TPU&lt;/b&gt;, &lt;b&gt;AWS Trainium&lt;/b&gt;, &lt;b&gt;Intel Gaudi&lt;/b&gt;, &lt;b&gt;AMD Instinct&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="980" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;H100&lt;/b&gt;, &lt;b&gt;H200&lt;/b&gt;, &lt;b&gt;B200&lt;/b&gt;, &lt;b&gt;GB200&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="980" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 14 -->
        <mxCell id="l14" value="14. Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="1050" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d14" value="Holds 8 accelerators, host CPUs, DRAM, and local NVMe with prestaged weights." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="1050" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o14" value="&lt;b&gt;Xeon&lt;/b&gt;, &lt;b&gt;EPYC&lt;/b&gt;, &lt;b&gt;Graviton&lt;/b&gt; hosts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="1050" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Grace&lt;/b&gt; CPU (GB200), &lt;b&gt;DGX&lt;/b&gt; and &lt;b&gt;HGX&lt;/b&gt; systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="1050" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 15 -->
        <mxCell id="l15" value="15. Network Fabric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C62828;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="1120" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d15" value="Scale up inside the node, scale out across nodes at 400 to 800 Gbps, plus a separate frontend network." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="1120" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o15" value="&lt;b&gt;ICI&lt;/b&gt; (TPU), &lt;b&gt;RoCE&lt;/b&gt; Ethernet, &lt;b&gt;Ultra Ethernet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="1120" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;NVLink&lt;/b&gt;, &lt;b&gt;InfiniBand&lt;/b&gt;, &lt;b&gt;Spectrum-X&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="1120" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 16 -->
        <mxCell id="l16" value="16. Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="1190" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d16" value="Object store holds checkpoints. New nodes pull weights from peer nodes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="1190" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o16" value="&lt;b&gt;S3&lt;/b&gt;, &lt;b&gt;GCS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="1190" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;GPUDirect Storage&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="1190" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 17 -->
        <mxCell id="l17" value="17. Cluster Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="1260" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d17" value="Places pods, drains unhealthy nodes, and rebalances pools as demand shifts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="1260" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o17" value="&lt;b&gt;Kubernetes&lt;/b&gt;, &lt;b&gt;KServe&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="1260" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;Run:ai&lt;/b&gt;, &lt;b&gt;DCGM&lt;/b&gt; health checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="1260" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 18 -->
        <mxCell id="l18" value="18. Facility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="1330" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d18" value="Liquid cooling, UPS, and generators. Each rack draws 40 to 130 kW." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="1330" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o18" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1330" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n18" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="1330" width="330" height="60" as="geometry"/></mxCell>

        <!-- Row 19 -->
        <mxCell id="l19" value="19. Power Grid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="1400" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="d19" value="Oregon draws BPA hydro. Arizona or Nevada draws solar plus storage. Power capacity sets the fleet ceiling." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="390" y="1400" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="o19" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1400" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="n19" value="None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#E0E0E0;fontColor=#9E9E9E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="1400" width="330" height="60" as="geometry"/></mxCell>

        <!-- Cross cutting -->
        <mxCell id="c1" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;&lt;br&gt;Operators track time to first token, time per output token, goodput per accelerator, cache hit rate, and errors per tenant. Alerts fire on SLO burn rate.&lt;br&gt;&lt;br&gt;Tools: &lt;b&gt;Prometheus&lt;/b&gt;, &lt;b&gt;Grafana&lt;/b&gt;, &lt;b&gt;OpenTelemetry&lt;/b&gt;, &lt;b&gt;DCGM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1450" y="140" width="280" height="300" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Model Release Pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each model version passes evals, safety review, and load tests. It ships to 1% of traffic, then expands while checks pass. Rollback swaps the weights pointer.&lt;br&gt;&lt;br&gt;Tools: &lt;b&gt;NeMo Evaluator&lt;/b&gt;, &lt;b&gt;NeMo Customizer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1450" y="460" width="280" height="320" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;br&gt;Data stays encrypted in transit and at rest. Zero retention tenants get no prompt logging. Tenants never share KV cache. Model weights sit behind tight access control." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1450" y="800" width="280" height="300" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;West Coast Sites&lt;/b&gt;&lt;br&gt;&lt;br&gt;Oregon primary carries 60% of traffic. Arizona or Nevada secondary carries 40%. Edge PoPs sit in LA, the Bay Area, and Seattle. Overflow spills to central US.&lt;br&gt;&lt;br&gt;Sizing: about 600 nodes, 4,800 accelerators, 6 MW." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1450" y="1120" width="280" height="340" as="geometry"/></mxCell>

        <!-- Reference paths and mnemonic -->
        <mxCell id="p1" value="&lt;b&gt;Open path (hardware neutral)&lt;/b&gt;&lt;br&gt;Kubernetes runs the llm-d scheduler, which feeds vLLM prefill and decode pods. LMCache and NIXL move KV cache. The pods run on TPU, Trainium, Gaudi, AMD, or NVIDIA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="1490" width="570" height="100" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;NVIDIA path (single vendor)&lt;/b&gt;&lt;br&gt;NIM packages the model. The Dynamo Smart Router feeds TensorRT-LLM engines. The Dynamo KV Block Manager and NIXL move KV cache over NVLink and InfiniBand. NeMo Guardrails screens content." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="1490" width="670" height="100" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;Memory hook&lt;/b&gt;&lt;br&gt;The tiers run A, C, C, H, I: Access, Control, Compute software, Hardware, Infrastructure.&lt;br&gt;&lt;i&gt;A Cool Cluster Hums Inside.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1450" y="1490" width="280" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
